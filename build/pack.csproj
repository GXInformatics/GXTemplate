<!--
    Packs GX.Blazor.Template.nuspec into a .nupkg.

        dotnet pack build/pack.csproj -o .

    This project compiles nothing and ships in no package. It exists only to carry the three
    properties below, because `dotnet pack` cannot be given them any other way.

    `dotnet pack GX.Blazor.Template.nuspec` does run, and looks like it worked. It is wrong.
    NuGet excludes every file whose name begins with a dot unless it is passed
    -NoDefaultExcludes, and the .nuspec path of `dotnet pack` accepts no such option: it is not
    MSBuild-driven, so -p:NoDefaultExcludes=true is ignored, and a bare -NoDefaultExcludes is
    read as a second .nuspec to pack. The resulting package is missing .editorconfig,
    .gitignore and .gitattributes, so every generated project loses its formatting
    rules and its ignore list, and nothing fails to tell you so.

    Packing through a project makes NoDefaultExcludes an ordinary MSBuild property, which is the
    only way to set it short of the full nuget.exe.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>

    <NuspecFile>$(MSBuildThisFileDirectory)..\GX.Blazor.Template.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildThisFileDirectory)..</NuspecBasePath>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <!--
      The commit this package is packed from, into the nuspec's <repository commit="$commit$"> (Pass 56).

      Read from git, never typed, so it cannot drift from what was actually packed. Refused outright
      if git cannot answer - not a shallow fallback - because a package that names no commit, or the
      literal "$commit$", is exactly the untraceable package this exists to prevent.

      Note what it records: HEAD. Content still comes from the WORKING TREE (the nuspec packs files on
      disk), so a pack from a tree with uncommitted changes names a commit that does not contain them.
      Pack releases from a clean tree.
  -->
  <Target Name="StampRepositoryCommit" BeforeTargets="GenerateNuspec">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(NuspecBasePath)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>

    <Error Condition="'$(_GitExitCode)' != '0' Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitCommit)', '^[0-9a-f]{40}$'))"
           Text="Could not resolve the git commit to record in the package (git rev-parse HEAD said: '$(_GitCommit)'). Pack from a git clone of the template with git on PATH; a package that cannot be traced to a commit is not shipped." />

    <PropertyGroup>
      <NuspecProperties Condition="'$(NuspecProperties)' == ''">commit=$(_GitCommit)</NuspecProperties>
      <NuspecProperties Condition="'$(NuspecProperties)' != '' And !$(NuspecProperties.Contains('commit='))">$(NuspecProperties);commit=$(_GitCommit)</NuspecProperties>
    </PropertyGroup>
  </Target>

  <!--
      Assert that the produced package actually contains what makes it a template package.

      This exists because "the package lacks what the repository has" has now bitten three times:
      Pass 8 §E.1 and Pass 9 §C both lost dot-directory contents to NuGet's default excludes, and
      Pass 13 §A had to open the .nupkg by hand to rule it out again. The failure is silent in the
      worst way - the package builds, installs without error, and simply offers no template, or
      offers one with no options in Visual Studio.

      Three template files are checked, and each has a distinct failure if it goes missing:
        template.json   - no template at all; `dotnet new install` reports success and installs nothing
        ide.host.json   - the template appears in Visual Studio with NO parameter page, because VS
                          hides every symbol unless a host file says otherwise (the CLI shows them
                          by default, which is why this can pass CLI testing and still be broken)
        icon.png        - the package icon the nuspec <icon> element points at

      One file is checked for ABSENCE: the maintainer's local src/Server.UI/appsettings.Development.json
      (see the assertion itself).

      Extracting is the only honest check: inspecting the nuspec would test our intent, not NuGet's
      output, and it is NuGet's own exclude rules that have caused every one of these failures.
  -->
  <Target Name="AssertTemplatePackageContents" AfterTargets="Pack" Condition="'$(NoPackageAssert)' != 'true'">
    <!--
        Found by globbing the output directory for the nuspec's package id.

        Neither obvious alternative works when packing from a NuspecFile: $(PackageId) is the
        PROJECT name ("pack"), not the nuspec's id, and @(NuGetPackOutput) carries the SDK's default
        guess at the filename rather than the one the nuspec actually produced. Both point at
        "pack.1.0.0.nupkg", which is never written.

        If the nuspec id ever changes, this glob matches nothing and the Error below fires - a loud
        failure rather than an assertion that silently stops asserting.
    -->
    <PropertyGroup>
      <_PackageOutDir>$([MSBuild]::EnsureTrailingSlash('$(PackageOutputPath)'))</_PackageOutDir>
      <_PackageAssertDir>$(IntermediateOutputPath)package-assert</_PackageAssertDir>
    </PropertyGroup>

    <ItemGroup>
      <_ProducedPackage Include="$(_PackageOutDir)GX.Blazor.Template.*.nupkg" />
    </ItemGroup>

    <RemoveDir Directories="$(_PackageAssertDir)" />

    <Error Condition="'@(_ProducedPackage)' == ''"
           Text="Pack produced no GX.Blazor.Template.*.nupkg in $(_PackageOutDir) to verify. If the nuspec id changed, update this glob." />

    <Unzip SourceFiles="@(_ProducedPackage)" DestinationFolder="$(_PackageAssertDir)" />

    <Error Condition="!Exists('$(_PackageAssertDir)\content\.template.config\template.json')"
           Text="The package is missing content/.template.config/template.json. It will install without error and offer no templates. Check the nuspec &lt;files&gt; rules and NoDefaultExcludes." />

    <Error Condition="!Exists('$(_PackageAssertDir)\content\.template.config\ide.host.json')"
           Text="The package is missing content/.template.config/ide.host.json. The template will appear in Visual Studio with NO parameter page, because VS hides every symbol unless a host file says otherwise. The CLI would still show them, so CLI testing will not catch this." />

    <Error Condition="!Exists('$(_PackageAssertDir)\content\.template.config\icon.png')"
           Text="The package is missing content/.template.config/icon.png, which ide.host.json references." />

    <!--
        The local-settings pair (the GX configuration layout). Generated projects get their
        appsettings.Development.json from .template.config/local-settings/; the maintainer's own
        src/Server.UI/appsettings.Development.json holds their local password and must never ship.
        It is gitignored, which keeps it out of git and nothing else: the nuspec packs the working
        tree, so only its exclude rule stands between that file and every copy of the package.
    -->
    <Error Condition="!Exists('$(_PackageAssertDir)\content\.template.config\local-settings\appsettings.Development.json')"
           Text="The package is missing content/.template.config/local-settings/appsettings.Development.json. Generated projects would have no local settings file, and would fail at startup with no connection string." />

    <Error Condition="Exists('$(_PackageAssertDir)\content\src\Server.UI\appsettings.Development.json')"
           Text="The package CONTAINS content/src/Server.UI/appsettings.Development.json: the maintainer's own local settings file, with whatever password it holds. Check the nuspec exclude for **\src\Server.UI\appsettings.Development.json, and do not distribute this package." />

    <!--
        Editor and agent state (Pass 56). .claude is the one that has actually shipped - 1.2.0 carried
        content/.claude/_._ - so it is asserted, not only excluded.
    -->
    <Error Condition="Exists('$(_PackageAssertDir)\content\.claude')"
           Text="The package CONTAINS content/.claude/ - Claude Code's local state (scheduled_tasks.lock and the like). Every generated project would receive it. Check the nuspec exclude for **\.claude\**." />

    <!--
        The commit, read back out of the PACKED nuspec rather than trusted from the property: NuGet
        leaves an unknown $token$ unreplaced without complaint, so only the output proves it.
    -->
    <PropertyGroup>
      <_PackedNuspec>$([System.IO.File]::ReadAllText('$(_PackageAssertDir)\GX.Blazor.Template.nuspec'))</_PackedNuspec>
    </PropertyGroup>
    <Error Condition="!$(_PackedNuspec.Contains('commit=&quot;$(_GitCommit)&quot;'))"
           Text="The packed nuspec does not record commit=&quot;$(_GitCommit)&quot; in its repository element. The package cannot be traced to its source; check the nuspec &lt;repository&gt; element and StampRepositoryCommit." />

    <Message Importance="high"
             Text="Template package contents verified: template.json, ide.host.json, icon.png and local-settings/appsettings.Development.json are present under content/.template.config/, no local src/Server.UI/appsettings.Development.json and no .claude/ were packed, and the nuspec records commit $(_GitCommit)." />

    <RemoveDir Directories="$(_PackageAssertDir)" />
  </Target>

</Project>
