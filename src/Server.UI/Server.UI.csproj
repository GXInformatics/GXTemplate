<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>CleanArchitecture.Blazor.Server.UI</RootNamespace>
        <AssemblyName>CleanArchitecture.Blazor.Server.UI</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>false</InvariantGlobalization>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <UserSecretsId>8118d19e-a6db-4446-bdb6-fa62b17f843d</UserSecretsId>
        <LangVersion>default</LangVersion>
        <!-- GX IIS deployment layout: Windows x64 servers; MSDeploy takes the site offline
             (app_offline.htm) while it copies, so locked assemblies do not fail the deploy. -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <EnableMSDeployAppOffline>true</EnableMSDeployAppOffline>
    </PropertyGroup>

    <ItemGroup>
        <!-- The server's web.config is the server's: it carries the connection strings and keys
             (see appsettings.json). A deploy must never overwrite or delete it. -->
        <MsDeploySkipRules Include="SkipWebConfig">
            <ObjectName>filePath</ObjectName>
            <AbsolutePath>web\.config$</AbsolutePath>
        </MsDeploySkipRules>
    </ItemGroup>

    <ItemGroup>
        <!-- TIME ZONES ON EVERY WINDOWS SERVER. The app names zones by their IANA ids ("Africa/Lagos": the
             DefaultTimeZone setting, every property, every user). On Windows, .NET resolves an IANA id only through
             ICU, and Windows ships ICU only from Windows 10 1903 / Windows Server 2022: on Windows Server 2019 and
             older the lookup fails, AppConfigurationSettings' startup check refuses the id, and IIS shows
             "500.30 - app failed to start" before the business database is created. So the app carries its own
             ICU: the package puts icuuc/icuin/icudt beside the app for win-x64, and the runtime option tells .NET to
             load them instead of the system's. The two version numbers must be the same. AppLocalIcuTests holds
             both. -->
        <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
        <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- The local settings file holds this machine's credentials. It is gitignored, and this
             keeps it off every server too: a publish or an MSDeploy from a developer machine would
             otherwise copy it into the site folder. ServerUiPublishTests reads the evaluated item. -->
        <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <!-- So the unit tests can reach internal helpers such as
             IdentityComponentsEndpointRouteBuilderExtensions.ResolveLocalReturnUrl without widening
             the assembly's public surface just to make a rule testable. -->
        <InternalsVisibleTo Include="CleanArchitecture.Blazor.Application.UnitTests" />
        <!-- Pass 30: so ServerHubTenantIsolationTests can call ServerHub.GroupFor, the single
             definition of "same presence audience". Making it public instead would put it on a
             Hub subclass, where public members read as client-invocable hub methods. -->
        <InternalsVisibleTo Include="CleanArchitecture.Blazor.Server.UI.IntegrationTests" />
    </ItemGroup>
 

    <ItemGroup>
       
        <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
        <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Pass 47b: replaces SixLabors.ImageSharp (ImageProcessor: profile photos and document images). MIT. Only the
             x64 native library (SkiaSharp.NativeAssets.Win32) is published for win-x64: the IIS pool must run 64-bit. -->
        <PackageReference Include="SkiaSharp" Version="4.154.0" />
        <PackageReference Include="MudBlazor" Version="9.8.0" />
        <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        
    </ItemGroup>
 
    <ItemGroup>
      <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
      <!--#if (UseSqlServer) -->
      <ProjectReference Include="..\Migrators\Migrators.MSSQL\Migrators.MSSQL.csproj" />
      <!--#endif -->
      <!--#if (UsePostgreSql) -->
      <ProjectReference Include="..\Migrators\Migrators.PostgreSQL\Migrators.PostgreSQL.csproj" />
      <!--#endif -->
      <ProjectReference Include="..\Migrators\Migrators.SqLite\Migrators.SqLite.csproj" />
    </ItemGroup>
    
     
 
   


</Project>
