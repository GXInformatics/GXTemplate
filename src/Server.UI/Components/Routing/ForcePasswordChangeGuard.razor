@using CleanArchitecture.Blazor.Application.Common.Constants
@using CleanArchitecture.Blazor.Server.UI.Pages.Identity.Login
@implements IDisposable
@inject NavigationManager Navigation

@code {
    // The circuit half of the forced-password-change enforcement. Navigation inside a live Blazor
    // circuit never becomes an HTTP request, so ForcePasswordChangeMiddleware cannot see it; this
    // component watches LocationChanged instead and sends a flagged user back to the change page.
    //
    // Renders nothing. It sits inside AppLayout's <Authorized> branch, which every page under
    // Pages/ is wrapped in.

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private bool _mustChange;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateTask;
        _mustChange = state.User.HasClaim(c => c.Type == ApplicationClaimTypes.MustChangePassword);

        if (!_mustChange) return;

        Navigation.LocationChanged += OnLocationChanged;
        Redirect();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Redirect();

    private void Redirect()
    {
        if (!_mustChange) return;

        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var pathOnly = "/" + path.Split('?', '#')[0].TrimEnd('/');

        // Never redirect the destination to itself, or the guard becomes a loop.
        if (string.Equals(pathOnly, ChangePassword.PageUrl, StringComparison.OrdinalIgnoreCase)) return;

        Navigation.NavigateTo(ChangePassword.PageUrl);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
