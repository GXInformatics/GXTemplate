@using CleanArchitecture.Blazor.Application.Common.Security
@using CleanArchitecture.Blazor.Application.Common.Interfaces.Identity
@using CleanArchitecture.Blazor.Application.Features.Tenants.DTOs
@using CleanArchitecture.Blazor.Application.Common.Interfaces
@inject IStringLocalizer<TenantSelector> L
@inject IUserProfileState UserProfileState
@* IPermissionService is deliberately no longer injected. This component used to consult it directly
   for Permissions.Users.SwitchTenants, which is what made the escalated permission invisible: the
   ladder was implemented here, badly, alongside a correct copy in the service. It now asks the
   service for the list and derives everything from that. *@
@inject ITenantSwitchService TenantSwitchService
@implements IDisposable


<MudStack Class="flex-grow-1" Row="true" AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween">
    
    <Logo Class="ml-4 mr-2" Style="width:32px;height32px" />
   

    @* A principal who cannot switch gets the organisation name as PLAIN CONTENT, not a disabled
       menu. The gate removes the action, not the information: which organisation you are in is
       something everyone needs to see, and a greyed-out control tells a user they are missing
       something without telling them what. "Absent, never disabled" is this template's own
       precedent - Pass 16A's Security tab, and Pass 25's deactivation gate, which kept the status
       visible while removing the toggle. *@
    @if (!_canSwitch)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-grow-1">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">
                    @L[ApplicationSettings.AppName]
                </MudText>
                <MudText Typo="Typo.subtitle2" Class="mud-secondary-text" Style="margin-top:-4px;">
                    @(UserProfile?.Tenant?.Name ?? "No Organization")
                </MudText>
            </MudStack>
        </MudStack>
    }
    else
    {
    <MudMenu AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight" LockScroll="true" Class="flex-grow-1">
        <ActivatorContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-grow-1">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">
                        @L[ApplicationSettings.AppName]
                    </MudText>
                    <MudText Typo="Typo.subtitle2" Class="mud-secondary-text" Style="margin-top:-4px;">
                        @(UserProfile?.Tenant?.Name ?? "No Organization")
                    </MudText>
                </MudStack>
                <MudIconButton Icon="@Icons.Material.Outlined.KeyboardDoubleArrowDown" Size="Size.Small" Class="mr-4" OnClick="@context.ToggleAsync" />
            </MudStack>
        </ActivatorContent>
        <ChildContent>
            <div style="min-width: 200px;">
                @if (UserProfile is not null)
                {
                    <div class="mx-4 mt-2 mb-3">
                        <MudText Typo="Typo.body2" Class="mud-secondary-text">
                            @L["Switch Organization"]
                        </MudText>
                    </div>
                    <MudDivider Class="my-2" />
                }

                @* Neither an empty case nor a loading case renders here any more. An empty switchable
                   set means the principal may not switch at all, and that is handled above by not
                   offering the menu; the list is loaded in OnInitializedAsync before this content is
                   ever shown, and is never null. Every tenant below is one the service will accept -
                   the list and the check come from the same rule. *@
                @foreach (var tenant in _switchableTenants)
                {
                        <MudMenuItem OnClick="() => SwitchToTenant(tenant.Id)" Disabled="@(_isSwitching)">
                            <div class="d-flex align-center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1">
                                        @tenant.Name
                                    </MudText>

                                    <MudText Typo="Typo.caption" Class="mud-secondary-text">
                                        @tenant.Description
                                    </MudText>

                                </MudStack>
                                @if (tenant.Id == UserProfile?.TenantId)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Class="ml-2" Color="Color.Primary" />
                                }
                            </div>
                        </MudMenuItem>
                    }
            </div>
        </ChildContent>
    </MudMenu>
    }
</MudStack>


@code
{
    private UserProfile UserProfile => UserProfileState.Value;

    /// <summary>
    /// The tenants this principal may switch into - from the service that also decides whether a
    /// switch is allowed.
    /// </summary>
    /// <remarks>
    /// <b>Not <c>UserProfile.AvailableTenants</c>, which this used to read.</b> That is a Mapster
    /// projection of <c>TenantUsers</c> - membership only - so it had nothing to show a holder of
    /// <c>Permissions.Users.SwitchToAnyTenant</c>, whose whole capability is switching into tenants
    /// they do NOT belong to. It stays as it is, a true statement of membership; this control simply
    /// asks a different question.
    /// <para>
    /// <b>And not the tenant datasource either.</b> That answers "which tenants may I SEE", bounded
    /// by <c>AllowedTenantIds</c> and widened by <c>Users.ViewAllTenants</c>. Seeing a tenant and
    /// being able to become it are different capabilities with different escapes, and collapsing
    /// them would silently grant one through the other.
    /// </para>
    /// </remarks>
    private IReadOnlyList<TenantDto> _switchableTenants = Array.Empty<TenantDto>();

    private bool _isSwitching;

    /// <summary>
    /// Whether this principal may switch at all - which is exactly "is the switchable set non-empty".
    /// </summary>
    /// <remarks>
    /// <b>Derived from the list, not from a separate permission check.</b> It used to be
    /// <c>HasPermissionAsync(SwitchTenants)</c> alone, which disabled the menu for a
    /// <c>SwitchToAnyTenant</c> holder even though the service would have permitted them to switch
    /// anywhere - the escalated permission had no UI at all. Asking the list means the gate and the
    /// service cannot disagree about the ladder, because only one of them implements it.
    /// </remarks>
    private bool _canSwitch => _switchableTenants.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        UserProfileState.Changed += OnUserProfileChanged;
        await LoadSwitchableTenantsAsync();
    }

    private async Task LoadSwitchableTenantsAsync()
    {
        var userId = UserProfile?.UserId;
        _switchableTenants = string.IsNullOrEmpty(userId)
            ? Array.Empty<TenantDto>()
            : await TenantSwitchService.GetSwitchableTenantsAsync(userId);
    }

    public void Dispose()
    {
        UserProfileState.Changed -= OnUserProfileChanged;
    }

    private void OnUserProfileChanged(object? sender, UserProfile userProfile)
    {
        InvokeAsync(StateHasChanged);
    }

     

    private async Task SwitchToTenant(string tenantId)
    {
        if (_isSwitching || string.IsNullOrEmpty(UserProfile?.UserId)) return;

        _isSwitching = true;
        try
        {
            var result = await TenantSwitchService.SwitchToTenantAsync(UserProfile.UserId, tenantId);

            if (result.Succeeded)
            {
                Snackbar.Add("Tenant switched successfully", Severity.Success);
                if (result.Errors.Any())
                {
                    Snackbar.Add(result.Errors.First(), Severity.Warning);
                }

                // Refresh user state
                await UserProfileState.RefreshAsync();

                // Navigate to home page.
                //
                // forceLoad: true is LOAD-BEARING for presence isolation and must not become a soft
                // navigation. ServerHub puts a connection into its tenant's SignalR group in
                // OnConnectedAsync, and a group is keyed by connection id - so the only way a
                // switched user leaves the previous tenant's presence group is for the connection to
                // be rebuilt. A full page load tears down the Blazor circuit, which disposes the
                // scoped HubClient and reconnects; a soft navigation would keep the circuit, keep
                // the connection, and leave the user watching their old tenant's colleagues sign in
                // and out with nothing failing. TenantSelectorComponentTests pins this.
                Navigation.NavigateTo("/", true);
            }
            else
            {
                Snackbar.Add(result.Errors.FirstOrDefault() ?? "Failed to switch tenant", Severity.Error);
            }
        }
        finally
        {
            _isSwitching = false;
        }
    }
}
