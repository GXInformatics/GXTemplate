<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
			<MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mb-n1" />
            @AppStrings.DeleteConfirmationTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@ContentText</MudText>
        @* Pass 52: a refusal (a failed result, a stale row) is shown here and the dialog stays open, as in ConfirmationDialog. *@
        @if (_failure is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" data-test="dialog-failure">@_failure</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel" title="@AppStrings.Cancel" Disabled="@_running" data-test="dialog-cancel">@AppStrings.Cancel</MudButton>
        <GxSubmitButton ButtonType="ButtonType.Button" Action="Submit" Label="@AppStrings.Confirm" BusyLabel="@AppStrings.Deleting"
                        Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" title="@AppStrings.Delete" data-test="dialog-confirm" />
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [EditorRequired][Parameter] public string? ContentText { get; set; }
    [EditorRequired][Parameter] public IRequest<Result> Command { get; set; } = default!;

    private bool _running;
    private string? _failure;

    private async Task Submit()
    {
        _running = true;
        _failure = null;
        try
        {
            _failure = await DialogAction.RunHeldOpenAsync(MudDialog, () => Mediator.FailureOf(Command));
        }
        finally
        {
            _running = false;
        }

        if (_failure is null)
        {
            Snackbar.Add($"{AppStrings.DeleteSuccess}", Severity.Info);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
