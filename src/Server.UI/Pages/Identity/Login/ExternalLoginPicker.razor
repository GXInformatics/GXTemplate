@using Microsoft.AspNetCore.Authentication
@using CleanArchitecture.Blazor.Domain.Identity
@inherits OwningComponentBase

@inject IStringLocalizer<ExternalLoginPicker> L
@if (_externalLogins.Length == 0)
{
    <MudText>@L["There are no external authentication services configured."]</MudText>
}
else
{
    <form class="form-horizontal" action="@IdentityComponentsEndpointRouteBuilderExtensions.PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <div class="d-flex flex-column flex-grow-1 gap-y-2">
                @foreach (var provider in _externalLogins)
                {
                    @* Pass 52: a native post that carries the button's own name=value; wwwroot/js/gx-busy-button.js shows the busy
                       state without disabling it, so the provider still reaches the endpoint. *@
                    <GxSubmitButton Label="@string.Format(L["Login with {0}"], provider.DisplayName)" BusyLabel="@L["Redirecting…"]"
                                    Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                    name="provider" value="@provider.Name" title="@($"Log in using your {provider.DisplayName} account")" />
                }
            </div>
        </div>
    </form>
}

@code {
    private AuthenticationScheme[] _externalLogins = [];
    private SignInManager<ApplicationUser> _signInManager = null!;
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _signInManager = ScopedServices.GetRequiredService<SignInManager<ApplicationUser>>();
        _externalLogins = (await _signInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }

}
