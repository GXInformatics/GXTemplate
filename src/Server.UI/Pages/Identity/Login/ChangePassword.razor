@page "/account/change-password"
@using System.ComponentModel.DataAnnotations
@using CleanArchitecture.Blazor.Application.Common.Constants
@using CleanArchitecture.Blazor.Domain.Identity
@using CleanArchitecture.Blazor.Server.UI.Resources.ValidationMessages
@using Microsoft.AspNetCore.Identity
@using CleanArchitecture.Blazor.Server.UI.Services

@attribute [Authorize]
@inherits OwningComponentBase
@inject IStringLocalizer<ChangePassword> L
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@_pageTitle</PageTitle>

<MudPaper Class="pa-8" Elevation="3" Style="max-width: 480px; margin: 0 auto;">
    <MudText Typo="Typo.h5" GutterBottom="true">@L["Choose a new password"]</MudText>

    @if (_mustChange)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            @L["Your account still uses a password that was generated for it. Choose your own before continuing."]
        </MudAlert>
    }

    <EditForm Model="@_model" OnValidSubmit="HandleValidSubmitAsync">
        <DataAnnotationsValidator/>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField InputType="@(_currentVisible ? InputType.Text : InputType.Password)"
                              Label="@L["Current password"]"
                              For="@(() => _model.CurrentPassword)"
                              @bind-Value="_model.CurrentPassword"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_currentVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _currentVisible = !_currentVisible)"/>
            </MudItem>
            <MudItem xs="12">
                <MudTextField InputType="@(_newVisible ? InputType.Text : InputType.Password)"
                              Label="@L["New password"]"
                              For="@(() => _model.NewPassword)"
                              @bind-Value="_model.NewPassword"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_newVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _newVisible = !_newVisible)"/>
            </MudItem>
            <MudItem xs="12">
                <MudTextField InputType="@(_confirmVisible ? InputType.Text : InputType.Password)"
                              Label="@L["Confirm new password"]"
                              For="@(() => _model.ConfirmPassword)"
                              @bind-Value="_model.ConfirmPassword"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_confirmVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _confirmVisible = !_confirmVisible)"/>
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-space-between align-center">
                @* Sign-out is never blocked - a user who cannot or will not change their password
                   must still be able to leave, or the flag becomes a lockout. The endpoint is a
                   POST, so this is a real form rather than a link. *@
                <form action="@IdentityComponentsEndpointRouteBuilderExtensions.Logout" method="post">
                    <input type="hidden" name="ReturnUrl" value="/account/login"/>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Size="Size.Small">
                        @L["Sign out instead"]
                    </MudButton>
                </form>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@_submitting">
                    @L["Change password"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    public const string PageUrl = "/account/change-password";

    private readonly InputModel _model = new();
    private string _pageTitle = string.Empty;
    private bool _mustChange;
    private bool _submitting;
    private bool _currentVisible;
    private bool _newVisible;
    private bool _confirmVisible;

    private UserManager<ApplicationUser> _userManager = null!;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _pageTitle = $"{ApplicationSettings.AppName} - {L["Change password"]}";
        _userManager = ScopedServices.GetRequiredService<UserManager<ApplicationUser>>();

        var state = await AuthenticationStateTask;
        _mustChange = state.User.HasClaim(c => c.Type == ApplicationClaimTypes.MustChangePassword);
    }

    private async Task HandleValidSubmitAsync()
    {
        _submitting = true;
        try
        {
            var state = await AuthenticationStateTask;
            var user = await _userManager.GetUserAsync(state.User);
            if (user is null)
            {
                Snackbar.Add(L["Your session has expired. Sign in again."], Severity.Error);
                Navigation.NavigateTo("/account/login", forceLoad: true);
                return;
            }

            // ChangePasswordAsync validates the current password, applies the configured policy to
            // the new one, and bumps the security stamp on success - which is what invalidates this
            // account's other sessions.
            var result = await _userManager.ChangePasswordAsync(
                user, _model.CurrentPassword, _model.NewPassword);

            if (!result.Succeeded)
            {
                Snackbar.Add(string.Join(" ", result.Errors.Select(e => e.Description)), Severity.Error);
                return;
            }

            if (user.MustChangePassword)
            {
                user.MustChangePassword = false;
                await _userManager.UpdateAsync(user);
            }

            Snackbar.Add(L["Password changed."], Severity.Success);

            // A full reload is what reissues the cookie from the updated user, dropping the
            // MustChangePassword claim. Without it the principal keeps the stale claim and the
            // guards would bounce the user straight back here.
            Navigation.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _submitting = false;
        }
    }

    public sealed class InputModel
    {
        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        [StringLength(50, MinimumLength = 8,
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordLength))]
        public string NewPassword { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
