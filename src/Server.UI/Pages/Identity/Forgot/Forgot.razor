@page "/account/forgot-password"
@attribute [AllowAnonymous]
@using CleanArchitecture.Blazor.Domain.Identity
@using CleanArchitecture.Blazor.Server.UI.Resources.ValidationMessages
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using CleanArchitecture.Blazor.Application.Features.Identity.Notifications.ResetPassword
@using System.ComponentModel.DataAnnotations

@inherits OwningComponentBase
@inject IStringLocalizer<Forgot> L
@inject ILogger<Forgot> Logger


<PageTitle>@_pageTitle</PageTitle>

<EditForm Model="_formModel" FormName="forgot-password" OnValidSubmit="HandleValidSubmitAsync" method="post">
	<DataAnnotationsValidator />
	<MudStack Spacing="2">
		<MudText Typo="Typo.h4" GutterBottom="true">@L["Forgot Password?"]</MudText>
		<MudText Typo="Typo.body1">@L["Please enter your registered email address. We will send you a password reset link if the account exists."]</MudText>

		<MudTextField @bind-Value="_formModel.Email"
					  Label="@L["E-mail"]"
					  Variant="Variant.Outlined"
					  InputType="InputType.Email"
					  Placeholder="@L["Enter your email address"]"
					  Immediate="true"
					  Required="true"
					  FullWidth="true"
					  For="@(() => _formModel.Email)" />
		<MudButton Variant="Variant.Filled"
				   Color="Color.Primary"
				   Size="Size.Large"
				   ButtonType="ButtonType.Submit"
				   FullWidth="true">
			@L["Send E-mail"]
		</MudButton>
	</MudStack>
</EditForm>

@code {
	public const string PageUrl = "/account/forgot-password";
	private string _pageTitle = "Forgot Password";
	private UserManager<ApplicationUser> _userManager = null!;
	private InputModel _formModel { get; set; } = new();

	protected override Task OnInitializedAsync()
	{
		_pageTitle = $"{ApplicationSettings.AppName} - {L["Forgot Password"]}";

		_userManager = ScopedServices.GetRequiredService<UserManager<ApplicationUser>>();
		return Task.CompletedTask;
	}

	private async Task HandleValidSubmitAsync()
	{
		// ONE outcome for every input. This page used to answer three different ways - a "no such
		// account" snackbar, a "not confirmed" snackbar, and a silent navigation on success - so an
		// anonymous visitor could sort any address into exists-and-confirmed, exists-unconfirmed,
		// or unknown, one request at a time. Neutralising the MESSAGE alone would not have been
		// enough: the navigation was a tell on its own, readable with the snackbar suppressed.
		//
		// The address is deliberately absent from this line, and the line is deliberately outside
		// every branch: logged per-request it records that a reset was asked for - the signal that
		// makes a spraying attempt visible - while answering nothing about which addresses exist.
		// It used to log the address on the SUCCESS branch only, which made the log database a
		// second oracle for anyone holding Permissions.Logs.View. (The mail handler still records
		// what it actually sent, and should: that is an operational record of outbound mail, not a
		// record of what an anonymous stranger typed.)
		Logger.LogInformation("Password reset requested.");

		var user = await _userManager.FindByEmailAsync(_formModel.Email);

		// AN UNCONFIRMED ADDRESS MAY RESET - ratified in Pass 22 §A. Pass 21 made the three
		// responses identical but deliberately left the behaviour alone; this is the policy answer
		// it was waiting for, and the behaviour now matches the response.
		//
		// A reset link proves mailbox control exactly as a confirmation link does: it is delivered
		// to that mailbox and nowhere else. Refusing it buys nothing and costs the user their only
		// route back except an administrator - and after Pass 21 they get the same silence as
		// everyone else, so they cannot even discover why. A completed reset therefore also CONFIRMS
		// the address (see ResetPassword.HandleValidSubmitAsync), which is standard practice and
		// strictly reduces the number of stranded accounts.
		//
		// An unknown address remains the one case that sends nothing, because there is nobody to
		// send to.
		if (user is not null)
		{
			var code = await _userManager.GeneratePasswordResetTokenAsync(user);
			code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
			var callbackUrl = Navigation.GetUriWithQueryParameters(
				Navigation.ToAbsoluteUri(ResetPassword.PageUrl).AbsoluteUri,
				new Dictionary<string, object?> { ["userId"] = user.Id, ["token"] = code });
			await Mediator.Publish(new ResetPasswordNotification(callbackUrl, user.Email!, user.UserName!));
		}

		// KNOWN RESIDUAL, accepted rather than fixed: the branch above does measurably more work
		// than skipping it - a token generation and a notification enqueue - so an attacker who can
		// measure response time can still separate "this address has an account" from "it does
		// not". Pass 22 §A narrowed this from three timing buckets to two, since an unconfirmed
		// address now does the same work as a confirmed one, but it does not close it. Closing it
		// means not doing the work on the request path at all, which changes what happens when mail
		// fails. Out of scope here; see the Pass 21 report.

		// No query parameters, and the same destination whatever the address was. The callback URL
		// above goes to the mail handler and nowhere else; it used to be appended here as well,
		// which put a live reset token in the address bar of whoever typed the address in -
		// account takeover with no mailbox access.
		Navigation.NavigateTo(ForgotPasswordConfirmation.PageUrl);

	}


	private sealed class InputModel
	{
        [Required(
        ErrorMessageResourceType = typeof(ValidationMessages),
        ErrorMessageResourceName = nameof(ValidationMessages.EmailRequired))]
    
        [EmailAddress(
        ErrorMessageResourceType = typeof(ValidationMessages),
        ErrorMessageResourceName = nameof(ValidationMessages.EmailInvalid))]
        public string Email { get; set; } = "";
	}

}
