@page "/account/forgotpasswordconfirmation"
@attribute [AllowAnonymous]

@inject IStringLocalizer<ForgotPasswordConfirmation> L
@inject ILogger<ForgotPasswordConfirmation> Logger

<PageTitle>@_pageTitle</PageTitle>

@* This page says one thing, always, to everyone. It used to accept a ResetPasswordLink query
   parameter and render it as a working button - so submitting a known address at
   /account/forgot-password handed an unauthenticated visitor a live reset token for that account,
   on screen and in the address bar. It was also an open redirect, because the href was whatever
   the query string said. Both are deleted rather than gated: a reset token does not belong in a
   URL in ANY environment, because URLs reach browser history, Referer headers, proxy logs,
   screenshots and shoulders. The link goes to the mailbox, and only to the mailbox. *@
<MudStack Spacing="2">
	<MudText Typo="Typo.h4" GutterBottom="true">@L["Check Your Inbox"]</MudText>
	<MudText Typo="Typo.body1">@L["If an account with the provided email exists, a password reset link has been sent. Please check your inbox and spam folder."]</MudText>
</MudStack>




@code {
    public const string PageUrl = "/account/forgotpasswordconfirmation";
    private string _pageTitle = "Forgot password confirmation";

    protected override void OnInitialized()
    {
        _pageTitle = $"{ApplicationSettings.AppName} - {L["Forgot password confirmation"]}";
    }

}
