@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Commands.AddEdit
@inherits MudComponentBase
@inject IStringLocalizer<PicklistSets> L

<MudDialog>
    <DialogContent>
        <MudForm Model="_model" @ref="_form" Validation="@(Validator.ValidateValue(_model))">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudEnumSelect Label="@L[_model.GetMemberDisplayName(x => x.Name)]" @bind-Value="_model.Name"
                                   For="@(() => _model.Name)"
                                   Placeholder="@L["Select picklist name"]"
                                   Required="true"
                                   RequiredError="@L["Name is required."]">
                    </MudEnumSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="@L[_model.GetMemberDisplayName(x => x.Description)]" @bind-Value="_model.Description"
                                  For="@(() => _model.Description)"
                                  Placeholder="@L["Enter description"]">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="@L[_model.GetMemberDisplayName(x => x.Value)]" @bind-Value="_model.Value"
                                  For="@(() => _model.Value)"
                                  Placeholder="@L["Enter value"]"
                                  Required="true"
                                  RequiredError="@L["Value is required."]">
                    </MudTextField>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="@L[_model.GetMemberDisplayName(x => x.Text)]" @bind-Value="_model.Text"
                                  For="@(() => _model.Text)"
                                  Placeholder="@L["Enter text"]"
                                  Required="true"
                                  RequiredError="@L["Text is required."]">
                    </MudTextField>
                </MudItem>

                @* Offered only to a holder, because the handler refuses it from anyone else - a
                   toggle that produces a refusal on Save is worse than no toggle. It is the second
                   line, not the guard: SharedPicklistWrite runs in the handler whatever this
                   renders. *@
                @if (CanManageShared)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_model.IsShared" Color="Color.Primary"
                                   Label="@L["Share this value with every tenant"]" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @L["A shared value is visible to every tenant in this installation and can be changed only by a holder of the 'manage shared picklists' permission. Leave this off to create the value for your own tenant only."]
                        </MudText>
                    </MudItem>
                }

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>
        <MudLoadingButton Loading="@_saving" Color="Color.Primary" OnClick="Submit">@AppStrings.Save</MudLoadingButton>
    </DialogActions>
</MudDialog>


@code
{
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [EditorRequired][Parameter] public AddEditPicklistSetCommand _model { get; set; } = default!;

    /// <summary>
    /// Whether the caller holds <c>Permissions.PicklistSets.ManageShared</c>, passed in by the page
    /// rather than resolved here - the page has already asked for its access rights, and asking
    /// twice would be two answers free to differ.
    /// </summary>
    [Parameter] public bool CanManageShared { get; set; }

    private MudForm _form = new();
    private bool _saving;

    private async Task Submit()
    {
        try
        {
            _saving = true;
            await _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(_model);

            if (result.Succeeded)
            {
                MudDialog.Close(DialogResult.Ok(true));
                Snackbar.Add(AppStrings.SaveSuccess, Severity.Info);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
