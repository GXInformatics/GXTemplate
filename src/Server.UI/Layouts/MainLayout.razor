@inherits LayoutComponentBase
@implements IDisposable
@inject LayoutService LayoutService
@inject IJSRuntime JS
<PageTitle>@ApplicationSettings.AppName</PageTitle>
@* Pass 52: nothing is rendered until the theme is known, so no page is ever painted in the wrong one. Until then the
   page is blank, in the device's scheme (app.css). The sign-in pages sit under this layout too (AuthLayout). *@
@if (_themeResolved)
{
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudThemeProvider Theme="@LayoutService.CurrentTheme" IsDarkMode="@LayoutService.IsDarkMode" />
    @Body
}

@code
{
    private bool _themeResolved;

    protected override void OnInitialized()
    {
        LayoutService.DarkModeChanged += OnDarkModeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // The device's prefers-color-scheme, through the function MudThemeProvider.GetSystemDarkModeAsync calls;
            // called directly because the provider is not rendered yet.
            var deviceIsDark = await JS.InvokeAsync<bool>("mudThemeProvider.isDarkMode");
            await LayoutService.ApplyUserPreferences(deviceIsDark);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        finally
        {
            // Whatever happened, the page is shown: in the light theme if nothing could be read.
            _themeResolved = true;
            StateHasChanged();
        }
    }

    private Task OnDarkModeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LayoutService.DarkModeChanged -= OnDarkModeChanged;
    }
}
