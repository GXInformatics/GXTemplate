@using System.Text.Json
@using Microsoft.AspNetCore.Antiforgery
@inject IHttpContextAccessor accessor
@inject IAntiforgery Antiforgery
@{
    var tokens = accessor.HttpContext is not null
        ? Antiforgery.GetAndStoreTokens(accessor.HttpContext)
        : null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet"/>
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet"/>
    <link href="@Assets["css/app.css"]" rel="stylesheet"/>
    <HeadOutlet @rendermode="RenderModeForPage"/>
    <ImportMap />
    <meta name="xsrf-token" content="@(tokens?.RequestToken)" />
    <!-- Site metadata. Every value here is either a neutral technical fact or comes from
         AppConfigurationSettings, so a generated project describes itself rather than the template
         it came from. Tags that could not be made neutral without inventing a brand, a description
         or an image URL were removed outright - see the pass report. -->
    <meta name="author" content="@ApplicationSettings.Company" />
    <!-- noindex by default: see wwwroot/robots.txt for the reasoning and for what to change for a
         public-facing deployment. robots.txt governs crawling; this tag governs indexing. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="application-name" content="@ApplicationSettings.AppName" />
    <meta name="generator" content="Blazor Server" />
    <meta name="theme-color" content="#1976d2" />

    <!-- Open Graph Tags. og:image and its dimensions are gone: a preview image would have to be
         invented, and a wrong one is worse than none. Twitter reads these when no twitter:* tags
         are present, which is why that block is gone rather than rewritten. -->
    <meta property="og:title" content="@ApplicationSettings.AppName" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@ApplicationSettings.ApplicationUrl" />
    <meta property="og:site_name" content="@ApplicationSettings.AppName" />
    <meta property="og:locale" content="en_US" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">@((MarkupString)StructuredData)</script>

    <title>@ApplicationSettings.AppName</title>
</head>

<body>
    <Routes @rendermode="RenderModeForPage"/>
	<ReconnectModal/>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
	<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
 
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" integrity="sha512-CNgIRecGo7nphbeZ04Sc13ka07paqdeTu0WR1IM4kNcpmBAUSHSQX0FslNhTDadL4O5SAGapGt4FodqL8My0mA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</body>

</html>

@code {
   // prerender: false is load-bearing for authorization. AuthorizationBehaviour denies any request
   // dispatched with no ambient IUserContextAccessor context, and that context is only populated for
   // circuit invocations - enabling prerendering would run every page's first render over plain HTTP
   // and deny it.
   private IComponentRenderMode? RenderModeForPage =>  new InteractiveServerRenderMode(false);

    /// <summary>
    /// Minimal, neutral structured data. Upstream's block advertised a named product with a price
    /// and a feature list; what survives is the shape - name, url, category - fed from configuration.
    /// Serialized rather than interpolated: the serializer escapes angle brackets and ampersands, so
    /// a configured name cannot close the script element it sits inside.
    /// </summary>
    private string StructuredData => JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebApplication",
        ["name"] = ApplicationSettings.AppName,
        ["url"] = ApplicationSettings.ApplicationUrl,
        ["applicationCategory"] = "BusinessApplication",
        ["operatingSystem"] = "Web Browser"
    });

    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

}
