{
  // STRUCTURE ONLY (the GX configuration layout). Every key is present; every secret or
  // environment-specific value is empty. Locally, the values come from the gitignored
  // appsettings.Development.json, which the template generates with this project's database names.
  // On a server, they come from that server's web.config (ASP.NET Core Module
  // <environmentVariables>, e.g. DatabaseSettings__ConnectionString), which overrides every
  // appsettings file. Never delete a key: it is the list of what a web.config has to supply.
  // CommittedAppSettingsTests fails if a secret-bearing key here, or in the Staging and Production
  // files, carries a value.
  "DatabaseSettings": {
    "DBProvider": "postgresql",
    "ConnectionString": "",
    // Serilog writes log rows to this SECOND database, and the SystemLogs page reads them back from
    // it. Same server, same provider - there is deliberately no second DBProvider - but its own
    // database, so routine backups of the business database do not swell with log volume and logs
    // can be retained under their own policy. The application creates the database on first start
    // when it is absent and the login may create databases, then creates its table. For production,
    // create it in advance so the login can stay unprivileged (README, step 3). Leave it blank and
    // the application still starts and runs, logging to console and file only, and says so loudly
    // at startup.
    "LogConnectionString": ""
  },
  // Bounds and bootstrap defaults ONLY. The idle timeout in force is administered at runtime under
  // Administration -> System -> Security Settings, and a user may shorten their own under
  // Profile -> Security. What is here is what an administrator may not exceed - plus the values a
  // fresh database is seeded with the first time the policy is read.
  //
  // MaxIdleTimeoutMinutes is the one value that is not merely a bound: it alone sizes the
  // authentication cookie (max + countdown + grace), which is issued once at sign-in and cannot be
  // shortened afterwards. That is why it is a deployment decision rather than an administrator's.
  //
  // Validated at startup: a countdown longer than the shortest window these bounds permit, a maximum
  // above eight hours, or a default outside [Min, Max] fails the process naming the value.
  "SecuritySettings": {
    "IdleTimeout": {
      // False switches the feature off end to end - no JS module is fetched, no principal check
      // runs, neither settings screen appears, and the cookie falls back to a fixed 8-hour lifetime.
      "Enabled": true,
      "DefaultIdleTimeoutMinutes": 15,
      "DefaultCountdownSeconds": 60,
      "MinIdleTimeoutMinutes": 1,
      "MaxIdleTimeoutMinutes": 120,
      // Whether users may shorten their own window. They can never lengthen it.
      "AllowUserOverride": true,
      // The browser pings an authenticated endpoint while the user is active, so the sliding cookie
      // renews. Turning this off inside a Blazor Server app means an actively working user's cookie
      // can expire underneath them - see the README.
      "KeepAlivePingEnabled": true,
      "CookieGraceMinutes": 2
    }
  },
  // External sign-in. Secret and environment-specific, so empty here like every other credential
  // and supplied per environment. A provider left empty is registered with a placeholder id
  // (DependencyInjection) and cannot complete a sign-in.
  "Authentication": {
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.Hosting.Lifetime": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error"
    }
  },
  "AppConfigurationSettings": {
    // Environment-specific: the public base URL used in email links. Supplied per environment.
    "ApplicationUrl": "",
    // Time zone given to a newly provisioned account when nobody has chosen one. Any id this
    // system recognises; validated at startup.
    "DefaultTimeZone": "Africa/Lagos",
    // When false, the registration pages AND the external-login account-provisioning callback
    // both return 404. Existing accounts sign in normally either way.
    "AllowSelfRegistration": false,
    "Version": "1.0.0",
    "App": "Blazor",
    "AppName": "GX Application",
    "Company": "GX Informatics Limited",
    "Copyright": "© 2026 GX Informatics Limited"
  },
  "AllowedHosts": "*",
  "Mail": {
    // Mailgun over its HTTP API. There is no SMTP option: the GX standard is the API, and it gives
    // a status code and a body to report when something fails.
    //
    // THE API KEY'S VALUE NEVER GOES IN A COMMITTED FILE. The key is listed, empty, so the structure
    // shows what a server must supply; its value comes from the environment only, as Mail__ApiKey
    // (on a server, from web.config). Domain and FromAddress are environment-specific and supplied
    // the same way. Region is the Mailgun account's region, not a secret.
    "Region": "US", // US or EU, matching where the sending domain is provisioned.
    "Domain": "", // e.g. mg.example.com
    "FromAddress": "", // e.g. noreply@mg.example.com
    "ApiKey": "",
    "FromName": "GX Application",
    // Leave empty. Empty means the development sink on a developer machine - messages rendered to
    // ./mail/ and never sent - and Mailgun everywhere else. Set to "Sink" or "Mailgun" to override.
    "Delivery": "",
    "SinkPath": "mail",
    // Deliberately short: an administrator waits on this synchronously when resending a
    // verification email, and HttpClient's 100-second default is indistinguishable from a hang.
    "TimeoutSeconds": 10
  },
  "Storage": {
    // "disk" stores under RootPath on the local filesystem; "azureblob" stores every key as a
    // blob name in a single container. Both serve files through the authenticated /files endpoint.
    "Provider": "disk",
    "RootPath": "Files",
    "ConnectionString": "",
    "ContainerName": "files",
    "CacheControlMaxAgeSeconds": 3600
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Properties": {
      "Application": "GX Application",
      "Environment": "Development",
      "TargetFramework": "net10"
    }

  },
  "IdentitySettings": {
    "RequireDigit": true,
    "RequiredLength": 8,
    "RequireNonAlphanumeric": true,
    "RequireUpperCase": true,
    "RequireLowerCase": true,
    "DefaultLockoutTimeSpan": 30
  },
  "SecurityAnalysis": {
    "HistoryDays": 30,
    "BruteForceWindowMinutes": 10,
    "AccountBruteForceThreshold": 3,
    "IpBruteForceThreshold": 10,
    "IpBruteForceAccountThreshold": 3,
    "AccountBruteForceScore": 50,
    "IpBruteForceScore": 50,
    "NewDeviceLocationScore": 25,
    "UnusualTimeScore": 15,
    "UnusualTimeStartHour": 22,
    "UnusualTimeEndHour": 6,
    "MediumRiskThreshold": 40,
    "HighRiskThreshold": 60,
    "CriticalRiskThreshold": 80,
    "CacheExpirationMinutes": 15
  }
}
