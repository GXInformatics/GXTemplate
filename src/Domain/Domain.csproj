<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>CleanArchitecture.Blazor.Domain</RootNamespace>
        <AssemblyName>CleanArchitecture.Blazor.Domain</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
        <!--#if (UsePostgreSql) -->
        <PackageReference Include="EntityFrameworkCore.Exceptions.PostgreSQL" Version="10.0.1" />
        <!--#endif -->
        <PackageReference Include="EntityFrameworkCore.Exceptions.Sqlite" Version="10.0.1" />
        <!--#if (UseSqlServer) -->
        <PackageReference Include="EntityFrameworkCore.Exceptions.SqlServer" Version="10.0.1" />
        <!--#endif -->
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
        <!--#if (UsePostgreSql) -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <!--#endif -->
        <!--#if (UseSqlServer) -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
        <!--#endif -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <!--#if (UsePostgreSql) -->
        <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
        <!--#endif -->
        <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
  
        <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
        <!-- Pass 47b (as ProjectTracking pass 28 D1): pinned past the advisories on 10.0.11, all fixed in 10.0.13 -
             Pkcs GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7; Xml GHSA-r955-8q5j-3h83, GHSA-c399-9853-6jmj, GHSA-7hqp-7c5m-4vq6.
             They come in through DataProtection.EntityFrameworkCore 10.0.11 (Pkcs and Xml) and, with SQL Server,
             Microsoft.Data.SqlClient 7.0.1 (Pkcs 9.0.13). Remove the pins when DataProtection.EntityFrameworkCore is past
             10.0.12 and SqlClient no longer brings a flagged Pkcs. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    </ItemGroup>

</Project>
