{
    "$schema": "http://json.schemastore.org/template",
    "author": "GX Informatics Limited",
    "classifications": ["Web","Blazor","Clean Architecture"],
    "name": "GX Blazor Server Solution (Clean Architecture)",
    "defaultName": "CleanArchitecture.Blazor",
    "identity": "GX.Blazor.Template.CSharp",
    "groupIdentity": "GX.Blazor.Template",
    "shortName": "gxblazor",
    "tags": {
      "language": "C#",
      "type": "project"
    },
    "sourceName": "CleanArchitecture.Blazor",
    "preferNameDirectory": true,
    "description": "This is a solution templates for creating a Blazor Server application following the principles of Clean Architecture",
    "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "README.md",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "templates/**/*",
        ".vs/**/*",
        ".vscode/**/*",
        "doc/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        "**/.git/**",
        "**/.github/**",
        "*.nuspec",
        "*.nupkg",
        "launchSettings.json",
        "*.exe",
        "src/Server.UI/Files/**",
        "graphify-out/**",
        "docs/**/*",
        ".codex/**/*",
        ".agents/**/*"
      ]
    }
  ]
  }
