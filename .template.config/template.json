{
  "$schema": "http://json.schemastore.org/template",
  "author": "GX Informatics Limited",
  "classifications": [ "Web", "Blazor", "Clean Architecture" ],
  "name": "GX Blazor Server Solution (Clean Architecture)",
  "defaultName": "CleanArchitecture.Blazor",
  "identity": "GX.Blazor.Template.CSharp",
  "groupIdentity": "GX.Blazor.Template",
  "shortName": "gxblazor",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanArchitecture.Blazor",
  "preferNameDirectory": true,
  "guids": [ "8118d19e-a6db-4446-bdb6-fa62b17f843d" ],
  "description":"A Blazor Server solution template for .NET 10 in Clean Architecture layers, with multi-tenant identity, deny-by-default authorization and transactional auditing. Business models you add are mapped into the core schema as TBL_UPPER_SNAKE automatically, by deriving from BaseEntity.",

  "symbols": {
    "Database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "postgresql",
      "displayName": "Database provider",
      "description": "The database the generated project uses. Only the chosen provider's packages, migration project and provider-specific tests are generated. SQLite is always included as well, because the test harnesses run on it.",
      "choices": [
        {
          "choice": "postgresql",
          "displayName": "PostgreSQL",
          "description": "Npgsql. The GX default."
        },
        {
          "choice": "mssql",
          "displayName": "SQL Server",
          "description": "Microsoft SQL Server or LocalDB."
        },
        {
          "choice": "sqlite",
          "displayName": "SQLite",
          "description": "A single file. Useful for evaluation and for the HTTP integration harness."
        }
      ]
    },

    "DatabaseName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Database name",
      "description": "The name of the databases the generated project connects to locally, written into its gitignored src/Server.UI/appsettings.Development.json. Leave empty to use the project name. The log database takes the same name with a _Logs suffix, so a project named IMS gets IMS and IMS_Logs. Anything outside letters, digits and underscore is stripped, because a database name with a space or a quote produces a connection string that fails obscurely at runtime."
    },

    "DefaultTimeZone": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Africa/Lagos",
      "displayName": "Default time zone",
      "description": "Time zone id given to a newly provisioned account when nobody has chosen one, for example Africa/Lagos or UTC. Validated when the generated application starts."
    },

    "AllowSelfRegistration": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Allow self-registration",
      "description": "Whether anonymous visitors may create their own accounts. When false the registration pages and the external-login account-provisioning callback both return 404. This is a runtime configuration flag, so a generated project can change it later without regenerating."
    },

    "UseSqlServer": {
      "type": "computed",
      "value": "(Database == \"mssql\")"
    },

    "UsePostgreSql": {
      "type": "computed",
      "value": "(Database == \"postgresql\")"
    },

    "DbProviderSetting": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"DBProvider\": \"postgresql\"",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(Database == 'mssql')", "value": "\"DBProvider\": \"mssql\"" },
          { "condition": "(Database == 'sqlite')", "value": "\"DBProvider\": \"sqlite\"" },
          { "condition": "(true)", "value": "\"DBProvider\": \"postgresql\"" }
        ]
      }
    },

    "DatabaseNameOrProject": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "DatabaseName",
        "fallbackVariableName": "name"
      }
    },

    "DatabaseNameSafe": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "replaces": "GXTemplateDatabase",
      "parameters": {
        "source": "DatabaseNameOrProject",
        "steps": [
          {
            "regex": "[^A-Za-z0-9_]",
            "replacement": ""
          }
        ]
      }
    },

    "DefaultTimeZoneSetting": {
      "type": "generated",
      "generator": "join",
      "replaces": "\"DefaultTimeZone\": \"Africa/Lagos\"",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "\"DefaultTimeZone\": \"" },
          { "type": "ref", "value": "DefaultTimeZone" },
          { "type": "const", "value": "\"" }
        ],
        "separator": "",
        "removeEmptyValues": false
      }
    },

    "AllowSelfRegistrationSetting": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"AllowSelfRegistration\": false",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(!AllowSelfRegistration)", "value": "\"AllowSelfRegistration\": false" },
          { "condition": "(true)", "value": "\"AllowSelfRegistration\": true" }
        ]
      }
    }
  },

  "SpecialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "style": "block",
            "startToken": "<!--",
            "endToken": "-->",
            "pseudoEndToken": "-- >",
            "keywords": {
              "keywordPrefix": "#"
            }
          }
        }
      ]
    }
  },

  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "(!UseSqlServer)",
          "exclude": [
            "src/Migrators/Migrators.MSSQL/**"
          ]
        },
        {
          "condition": "(!UsePostgreSql)",
          "exclude": [
            "src/Migrators/Migrators.PostgreSQL/**"
          ]
        },
        {
          "condition": "(!UseSqlServer && !UsePostgreSql)",
          "exclude": [
            "tests/Application.UnitTests/Logging/SinkTimestampAcceptanceTests.cs"
          ]
        }
      ],
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        ".vs/**/*",
        "doc/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        "**/.git/**",
        "**/.github/**",
        "*.nuspec",
        "*.nupkg",
        "**/launchSettings.json",
        "**/*.exe",
        "**/*.db",
        "**/*.db-shm",
        "**/*.db-wal",
        "src/Server.UI/Files/**",
        "src/Server.UI/[Ll]og/**",
        "src/Server.UI/[Mm]ail/**",
        "docs/**/*",
        "build/**/*",
        "tooling/**/*",
        "GXTemplate-passes/**/*",
        "Directory.Build.props",
        "src/Server.UI/appsettings.Development.json"
      ]
    },
    {
      "source": "./.template.config/local-settings/",
      "target": "./src/Server.UI/",
      "include": [ "appsettings.Development.json" ]
    }
  ]
}
