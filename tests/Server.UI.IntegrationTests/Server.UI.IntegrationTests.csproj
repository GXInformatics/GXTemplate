<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>CleanArchitecture.Blazor.Server.UI.IntegrationTests</RootNamespace>
        <AssemblyName>CleanArchitecture.Blazor.Server.UI.IntegrationTests</AssemblyName>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="nunit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <!-- Pass 10: component-level tests. Every test before this pass observed HTTP only, and
             with the app rendered at InteractiveServer(prerender: false) an HTTP response carries
             none of the component tree - so a layout that redirected an authenticated user away
             from the change-password page was invisible to all of them. bUnit renders the real
             components in-process, which is the only way to see that decision. -->
        <PackageReference Include="bunit" Version="2.9.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <!-- Pass 41: the reconnect logic is JavaScript, because it has to keep working while the
             circuit - and therefore all C# - is gone. Jint is a pure-C# JS interpreter, so
             ReconnectUiTests drives the REAL wwwroot/js/gxReconnect.js through the real .NET 10
             state sequences with no Node, no browser and no native dependency. Without it the only
             thing a test could assert about that file is that it exists. -->
        <PackageReference Include="Jint" Version="4.16.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Linked, not copied: the test runs the file the application actually ships. A second
             copy would drift, and a drifted copy would keep passing. -->
        <Content Include="..\..\src\Server.UI\wwwroot\js\gxReconnect.js" Link="gxReconnect.js"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Server.UI\Server.UI.csproj" />
        <ProjectReference Include="..\TestSupport\TestSupport.csproj" />
    </ItemGroup>

</Project>
