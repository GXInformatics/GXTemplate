<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>CleanArchitecture.Blazor.Application.IntegrationTests</RootNamespace>
        <AssemblyName>CleanArchitecture.Blazor.Application.IntegrationTests</AssemblyName>

        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>

        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="nunit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <!-- Pass 47b (as ProjectTracking pass 28 D1): pinned past GHSA-334f-vvp4-7g6p (fixed in 10.0.13). It comes in through
             Server.UI's SignalR.Client 10.0.11, which Server.UI itself takes from the shared framework (pruned); a test
             project does not. Remove the pin when SignalR.Client is past 10.0.12. -->
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Server.UI\Server.UI.csproj" />
        <ProjectReference Include="..\TestSupport\TestSupport.csproj" />
    </ItemGroup>

</Project>