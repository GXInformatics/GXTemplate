{
  // No DatabaseSettings here, deliberately: the database is gx_test_<project>_appint on the server
  // named by GX_TEST_PG (see Testing.cs and tests/TestSupport/PostgresTestDatabase.cs). Without
  // GX_TEST_PG every database test in this project FAILS, naming the variable.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppConfigurationSettings": {
    "ApplicationUrl": "https://example.com",
    "Version": "1.2.3",
    "App": "Blazor",
    "AppName": "GX Application",
    "Company": "Company",
    "Copyright": "@2024 Copyright"
  },
  "AllowedHosts": "*",
  "Mail": {
    // The sink, stated rather than inferred: these tests must never attempt a network call, and
    // they do not run under the Development environment that would default to it.
    "Delivery": "Sink"
  },
  "PrivacySettings": {
    "LogClientIpAddresses": true,
    "LogClientAgents": true
  },
  "IdentitySettings": {
    "RequireDigit": false,
    "RequiredLength": 6,
    "RequireNonAlphanumeric": false,
    "RequireUpperCase": false,
    "RequireLowerCase": false,
    "DefaultLockoutTimeSpan": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire.BackgroundJobServer": "Error",
        "Hangfire.Server.BackgroundServerProcess": "Error",
        "Hangfire.Server.ServerHeartbeatProcess": "Error",
        "Hangfire.Processing.BackgroundExecution": "Error",
       
      }
    },
    "Properties": {
      "Application": "GX Application"
    }
  }
}
