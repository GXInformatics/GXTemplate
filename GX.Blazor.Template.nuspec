<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
    <metadata>
        <id>GX.Blazor.Template</id>
        <version>1.0.0</version>
        <title>GX Blazor Server Solution Template</title>
        <authors>GX Informatics Limited</authors>
        <description>
            A Blazor Server solution template for .NET 10, laid out in Clean Architecture layers.
            Ships multi-tenant ASP.NET Core Identity with permission claims, deny-by-default
            authorization on every request, transactional audit trails, structured logging into a separate
            log database, and Documents and PicklistSets as worked examples.
        </description>
        <summary>
            Blazor Server solution template for .NET 10 in Clean Architecture layers, with
            multi-tenant identity, deny-by-default authorization and transactional auditing.
        </summary>
        <releaseNotes>
            1.0.0
            - First GX release, derived from CleanArchitectureWithBlazorServer.
            - Deny-by-default request authorization with a startup assertion.
            - Audit rows written in the same transaction as the change they describe.
            - Structural per-principal cache scoping.
            - Demo features (Products, Contacts, chatbot, document OCR) removed.
        </releaseNotes>

        <license type="expression">MIT</license>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <copyright>Copyright (c) 2019 Jason Taylor and contributors; portions copyright (c) GX Informatics Limited</copyright>
        <tags>blazor blazor-server clean-architecture multi-tenant dotnet10 template csharp</tags>
        <icon>icon.png</icon>
        <readme>README.md</readme>

        <packageTypes>
            <packageType name="Template"/>
        </packageTypes>
    </metadata>

    <files>
        <!-- The package icon and readme, at the package root, which is where the <icon> and
             <readme> elements above look. -->
        <file src=".template.config\icon.png" target="icon.png"/>
        <file src="README.md" target="README.md"/>

        <!--
            Everything the template instantiates, under content/.

            .template.config MUST be included: template.json and ide.host.json are what make this a
            template package rather than an ordinary one, and excluding them produces a package that
            installs without error and offers no templates.

            LICENSE and README.md are included too - a generated project should carry its licence and
            its documentation.

            EVERY exclude pattern below must begin with **\. NuGet matches these against the
            resolved absolute path of each file, so a root-anchored pattern such as docs\** is
            compared against C:\...\GXTemplate\docs\... and never matches - it excludes nothing,
            silently. That is not hypothetical: docs\** and doc\** matched nothing and shipped
            6.5 MB of screenshots and design notes inside the package until Pass 9.
        -->
        <file src=".\**" target="content"
              exclude="**\*.exe;**\*.nuspec;**\*.nupkg;**\bin\**;**\obj\**;**\.vs\**;**\.git\**;**\.github\**;**\wwwroot\dist\**;**\docs\**;**\doc\**;**\launchSettings.json;**\*.user;**\*.filelist;**\*.db;**\*.db-shm;**\*.db-wal;**\src\Server.UI\Files\**;**\src\Server.UI\log\**;**\GXTemplate-passes\**;**\build\**"/>
    </files>

</package>
